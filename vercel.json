{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(index.html|platform.js|config.js)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/jobber-callback",
      "destination": "/api/jobber?action=callback"
    }
  ],
  "crons": [
    {
      "path": "/api/jobber?action=cron",
      "schedule": "0 10 * * *"
    }
  ],
  "functions": {
    "api/jobber.js": {
      "maxDuration": 60
    }
  }
}